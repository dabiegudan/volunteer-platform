# ==============================================================================
# 一体式志愿者服务平台 —— 环境变量模板
# ------------------------------------------------------------------------------
# 用法：
#   cp .env.example .env      （Linux / macOS）
#   Copy-Item .env.example .env   （Windows PowerShell）
#   然后填入真实值。.env 已被 .gitignore 忽略，绝对不会被提交。
#
# 说明：
#   本文件是【容器路线唯一需要填写的敏感信息载体】。
#   - Docker Compose 会自动读取项目根目录的 .env 用于变量替换
#   - Spring Boot 不读取 .env，只读取【系统环境变量】
#     → 容器场景：由 docker-compose 的 environment 段注入
#     → 本机场景（推荐）：不用本文件，改为写 volunteer-backend/volunteer-server/
#       src/main/resources/application-local.yml（已被 .gitignore 忽略），
#       dev profile 通过 spring.config.import 自动加载，无需每次开终端 source
#     → 本机场景（兼容旧流程）：由 scripts/load-env.ps1 | load-env.sh 导入当前 shell
#   两种本机方式可共存，环境变量优先级更高。
#   注意：application.yml / application-dev.yml 里【不再有】jwt.secret 与
#   encrypt.secret-key 这两个键 —— spring.config.import 导入的属性源优先级低于声明它的
#   文档，写成 jwt.secret: ${JWT_SECRET:} 会用一个空默认值盖住 application-local.yml。
#   环境变量不受影响：宽松绑定会把 JWT_SECRET / ENCRYPT_SECRET_KEY 直接映射到这两个键。
#
# 生成强随机值（Windows PowerShell）：
#   .\scripts\gen-secrets.ps1
#
# 安全要求：
#   - JWT_SECRET          长度 ≥ 32 字符（JwtUtil 启动时强校验，不足直接启动失败）
#   - ENCRYPT_SECRET_KEY  AES 密钥，建议 32 字符
#   - 所有口令使用强随机值，禁止沿用示例值
#   - 严禁把真实值写入 .env.example、docker-compose.yml、application.yml 或任何代码文件
#     （application-local.yml 是唯一例外，因为它本身不入库）
# ==============================================================================

# ==============================================================================
# 1. 运行环境
# ==============================================================================
# dev | prod        prod 下数据库口令、JWT 密钥、MinIO 密钥均无默认值，缺失即启动失败
SPRING_PROFILES_ACTIVE=dev
# 容器时区（与 JDBC serverTimezone、Jackson time-zone 保持一致）
TZ=Asia/Shanghai

# ==============================================================================
# 2. 应用端口
# ==============================================================================
# Spring Boot 监听端口（映射关系见 docker-compose.env.yml：8080 -> 8081）
SERVER_PORT=8081

# ==============================================================================
# 3. MySQL 数据库
#     本项目数据库账号密码均为 root，以下默认值可直接使用
# ==============================================================================
# ---- 3.1 MySQL 容器自身初始化（仅首次创建数据卷时生效）----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=volunteer_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---- 3.2 Spring Boot 连接参数 ----
# 注意：SPRING_DATASOURCE_URL 优先级高于 DB_HOST/DB_PORT/DB_NAME 拼装结果。
#       本项目统一使用 SPRING_DATASOURCE_URL，避免两种方式互相覆盖。
#       容器内主机名为 mysql（服务名）；本机开发改为 localhost。
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/volunteer_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# ---- 3.2b 供 docker-compose.yml 使用 ----
# 后端容器通过该地址访问【宿主机】MySQL（Compose 的 ${VAR:default} 不支持默认值含冒号，
# 因此必须由 .env 显式提供本变量）
SPRING_DATASOURCE_URL_HOST=jdbc:mysql://host.docker.internal:3306/volunteer_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ---- 3.3 连接池（可选，留空则使用 application.yml 默认值）----
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# ---- 3.4 数据库迁移（Flyway 基线方案）----
# 脚本目录：volunteer-backend/volunteer-server/src/main/resources/db/migration
#   V1__baseline_full_schema.sql  基线：全量 70 张表 + 索引 + 外键 + 种子数据
#   V2__...                       增量：基线之后的每一次结构变更各一个脚本
#
# 两种场景：
#   全新空库      -> Flyway 执行 V1 建全量结构，再执行 V2 及之后（无需任何手工操作）
#   已有数据库    -> 自动建立基线（版本 1），跳过 V1，只执行 V2 及之后，数据不受影响
#
# 是否启用迁移。false 时完全关闭，改为手工执行 db/init.sql。
FLYWAY_ENABLED=true
# 已有非空库是否自动建立基线。
#   开发/测试：true（省事）
#   生产建议：false，首次上线按文档手工执行 flyway baseline，避免误连错库被静默打基线
FLYWAY_BASELINE_ON_MIGRATE=true
# 基线版本 = 被基线覆盖的最后一个迁移版本。V1 是全量初始化，故为 1。
# 设错后果：偏小 -> V1 在已有库上重复执行报 "Table already exists"；
#           偏大 -> 中间的增量脚本被永久跳过。
FLYWAY_BASELINE_VERSION=1
# 禁止 flyway clean（会清空整个库），任何环境都不要改
FLYWAY_CLEAN_DISABLED=true
# 【重要】MySQL 下该配置**无法创建数据库**，只能创建库内的 schema：
#   Flyway 在取得 JDBC 连接之后才执行 createSchemas，而库不存在时 MySQL 驱动
#   在连接阶段就报 Unknown database，因此库本身必须预先存在。
#   建库方式：本机由 db/init.sql 建库；Docker 由 MYSQL_DATABASE 自动建库；生产由 DBA 预建。
#   故保持 false，避免误解。
FLYWAY_CREATE_SCHEMAS=false

# ==============================================================================
# 4. Redis ——【必须设置密码，编排文件会强制校验】
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# 生成：openssl rand -hex 12
REDIS_PASSWORD=replace-me-with-a-random-redis-password
REDIS_DB=0
REDIS_TIMEOUT=3000

# ==============================================================================
# 5. MinIO 对象存储
# ==============================================================================
# ---- 5.1 MinIO 容器自身凭据（默认值，无需修改；生产务必更换）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- 5.2 Spring Boot 连接参数 ----
# MINIO_ENDPOINT          本机地址（宿主机端口 9090，与 9090:9000 映射一致）
#                         application-dev.yml 的默认值同为 http://localhost:9090
# MINIO_ENDPOINT_INTERNAL 容器内地址，由 docker-compose 注入后端容器
MINIO_ENDPOINT=http://localhost:9090
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=volunteer
# 是否在启动时自动创建桶（默认 false；开发环境建议 true，省去手工建桶步骤）
# 生产建议保持 false，由运维以基础设施即代码方式创建，避免应用账号拥有建桶权限
MINIO_AUTO_CREATE_BUCKET=false
# MinIO 控制台对外端口
MINIO_CONSOLE_PORT=9091

# ==============================================================================
# 6. 大语言模型（DeepSeek / 任意 OpenAI 兼容服务）
# ==============================================================================
# 必填：不填则所有 /api/ai/** 接口在调用时失败（应用仍可正常启动）
LLM_API_KEY=change-me-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_EMBEDDING_MODEL=text-embedding-ada-002
LLM_TYPE=deepseek
LLM_TIMEOUT=60000

# ==============================================================================
# 7. 安全密钥 ——【无内置默认值，必须提供，否则应用无法启动】
# ==============================================================================
# JWT HS256 签名密钥：长度必须 ≥ 32 字符，JwtUtil 与 EncryptUtil 会在启动时强校验
# 生成：openssl rand -hex 32   或   .\scripts\gen-secrets.ps1
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
# Token 有效期（毫秒），86400000 = 24 小时
JWT_EXPIRATION=86400000
# 敏感字段 AES-256-GCM 加密密钥（身份证号等），至少 16 字符，建议 32 字符
# 警告：更换此密钥会导致历史已加密数据无法解密，必须同步做数据迁移
ENCRYPT_SECRET_KEY=replace-me-with-a-32-char-aes-key

# ==============================================================================
# 8. 跨域与上传限制
# ==============================================================================
# 允许的前端来源，逗号分隔（前端 H5 开发默认 5173，端口顺延时需同步追加）
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# 单文件 / 单请求大小上限
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# ==============================================================================
# 9. 日志与运维
# ==============================================================================
# prod 建议 WARN；dev 用 INFO
LOGGING_LEVEL_ROOT=INFO
# 业务包日志级别
LOGGING_LEVEL_COM_VOLUNTEER=DEBUG
# MyBatis SQL 日志：生产必须设为 INFO 或删除（会打印 SQL，泄漏数据且影响性能）
LOGGING_LEVEL_ORG_MYBATIS=DEBUG

# 短信：true = 仅打印到控制台，不真实发送
SMS_CONSOLE_ENABLED=true
SMS_PROVIDER_NAME=console

# ==============================================================================
# 10. 前端构建变量（前端不读 .env 的运行时值，仅作开发构建时的备忘）
# ==============================================================================
# 生产构建（npm run build:h5）使用同源相对路径 /api/**，**不需要**本变量。
# 仅开发构建（npm run dev:h5）使用；留空则回退 http://localhost:8081。
# 若前端页面与后端不同源（例如页面在 :5173、后端在 :8080），才需要填后端地址，
# 并同时把页面来源加入 APP_CORS_ALLOWED_ORIGINS。
VITE_API_BASE_URL=
